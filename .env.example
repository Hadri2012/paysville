# ---------------------------------------------------------------------------
# Hadrishop — variables d'environnement
# Copiez ce fichier en `.env.local` (développement) ou renseignez ces variables
# dans le tableau de bord de votre hébergeur (production).
# Ne committez JAMAIS le fichier `.env.local` : il contient des secrets.
# ---------------------------------------------------------------------------

# --- Stripe (obligatoire pour encaisser) -----------------------------------
# Clé secrète : tableau de bord Stripe > Développeurs > Clés API.
# Elle reste UNIQUEMENT côté serveur, jamais dans le navigateur.
STRIPE_SECRET_KEY=

# Secret de signature du webhook : Stripe > Développeurs > Webhooks,
# après avoir créé un endpoint vers https://VOTRE-DOMAINE/api/stripe/webhook
# Événements à écouter : checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=

# --- Administration ---------------------------------------------------------
# Compte administrateur créé à la PREMIÈRE connexion sur /admin/login.
# Le mot de passe est immédiatement haché (scrypt) puis conservé en base :
# il n'est jamais stocké en clair.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- URL publique -----------------------------------------------------------
# Utilisée pour les redirections Stripe (succès / annulation).
# Ex. https://hadrishop.example — sans slash final.
NEXT_PUBLIC_SITE_URL=

# --- Base de données --------------------------------------------------------
# Facultatif en développement (un fichier .data/hadrishop.json est utilisé).
# INDISPENSABLE en production pour que les données survivent aux déploiements.
# Chaîne de connexion PostgreSQL, ex. :
# postgres://utilisateur:motdepasse@hote:5432/hadrishop
DATABASE_URL=

# Mettre à "disable" si votre PostgreSQL n'utilise pas TLS.
# DATABASE_SSL=disable

# Emplacement du fichier de données quand DATABASE_URL n'est pas défini.
# HADRISHOP_DATA_FILE=.data/hadrishop.json

# --- Contournement de test (facultatif) --------------------------------------
# Permet de valider une commande sans paiement Stripe réel, pour tester le
# parcours d'achat de bout en bout. N'a AUCUN effet tant que ces deux variables
# ne sont pas toutes les deux définies, et refuse de fonctionner si une clé
# Stripe de production (sk_live_…) est configurée : ne peut jamais servir sur
# la boutique réelle. Ne committez jamais la valeur du code.
# TEST_ORDER_BYPASS_CODE=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX
# NEXT_PUBLIC_TEST_CHECKOUT_ENABLED=true
